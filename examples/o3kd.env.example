O3K_DATA_DIR=/var/lib/o3k
O3K_BOOTSTRAP_PASSWORD=CHANGE_ME
O3K_TOKEN_SIGNING_KEY=GENERATE_A_RANDOM_32_BYTE_OR_LONGER_VALUE
# Optional canonical region & availability-domain topology (ADR-0181/SPEC-0038).
# JSON array of {id, availability_domains:[{id},...]}. Unset/empty => no regions
# are advertised (never fabricated). See docs/specs/SPEC-0038 for semantics.
#O3K_LOCATIONS=[{"id":"region-a","availability_domains":[{"id":"az-1"}]}]
