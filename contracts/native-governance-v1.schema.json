{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://o3k.io/contracts/native-governance-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/project" },
          { "$ref": "#/$defs/principal" },
          { "$ref": "#/$defs/roleAssignment" }
        ]
      }
    },
    "next_cursor": { "type": ["string", "null"] }
  },
  "$defs": {
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "domain_id", "name", "description", "enabled", "created_at"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "domain_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "enabled": { "type": "boolean" },
        "created_at": { "type": "string", "minLength": 1 }
      }
    },
    "principal": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "domain_id", "name", "email", "enabled", "created_at"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "domain_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "email": { "type": ["string", "null"] },
        "enabled": { "type": "boolean" },
        "created_at": { "type": "string", "minLength": 1 }
      }
    },
    "roleAssignment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "principal_id", "project_id", "role_id", "created_at"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "principal_id": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "role_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "minLength": 1 }
      }
    }
  }
}
