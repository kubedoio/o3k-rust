{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://o3k.io/contracts/native-metering-v1.schema.json",
  "title": "O3K Native Metering v1",
  "description": "Bounded, read-only projection of canonical O3K metering authority: the public meter catalog and per-scope usage with explicit completeness. Time instants are RFC3339 UTC; a usage number is never returned without a status. See ADR-0183 / SPEC-0046.",
  "x-o3k-status": "accepted",
  "definitions": {
    "unit": {
      "enum": ["instance_second", "vcpu_second", "byte_second"]
    },
    "aggregation": {
      "enum": ["integral"]
    },
    "granularity": {
      "enum": ["hour", "day"]
    },
    "status": {
      "enum": ["complete", "partial", "unavailable"]
    },
    "quantity": {
      "type": "string",
      "pattern": "^-?[0-9]+\\.[0-9]{3}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "meterDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "owning_service",
        "unit",
        "aggregation",
        "resource_type",
        "supported_granularities",
        "tenant_visible",
        "operator_visible",
        "description",
        "version"
      ],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "owning_service": { "type": "string", "minLength": 1 },
        "unit": { "$ref": "#/definitions/unit" },
        "aggregation": { "$ref": "#/definitions/aggregation" },
        "resource_type": { "type": "string", "minLength": 1 },
        "supported_granularities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/granularity" }
        },
        "tenant_visible": { "type": "boolean" },
        "operator_visible": { "type": "boolean" },
        "description": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "meterDefinitionsPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definitions", "has_more", "next_cursor"],
      "properties": {
        "definitions": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/definitions/meterDefinition" }
        },
        "has_more": { "type": "boolean" },
        "next_cursor": { "type": ["string", "null"] }
      }
    },
    "usageBucket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket_start", "bucket_width_ms", "quantity"],
      "properties": {
        "bucket_start": { "$ref": "#/definitions/instant" },
        "bucket_width_ms": { "type": "integer", "minimum": 1 },
        "quantity": { "$ref": "#/definitions/quantity" }
      }
    },
    "meterUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "meter_key",
        "unit",
        "aggregation",
        "granularity",
        "start",
        "end",
        "observed_through",
        "authority_started_at",
        "last_observed_at",
        "status",
        "buckets",
        "total"
      ],
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "meter_key": { "type": "string", "minLength": 1 },
        "unit": { "$ref": "#/definitions/unit" },
        "aggregation": { "$ref": "#/definitions/aggregation" },
        "granularity": { "$ref": "#/definitions/granularity" },
        "start": { "$ref": "#/definitions/instant" },
        "end": { "$ref": "#/definitions/instant" },
        "observed_through": { "$ref": "#/definitions/instant" },
        "authority_started_at": {
          "anyOf": [{ "$ref": "#/definitions/instant" }, { "type": "null" }]
        },
        "last_observed_at": {
          "anyOf": [{ "$ref": "#/definitions/instant" }, { "type": "null" }]
        },
        "status": { "$ref": "#/definitions/status" },
        "buckets": {
          "type": "array",
          "maxItems": 1100,
          "items": { "$ref": "#/definitions/usageBucket" }
        },
        "total": { "$ref": "#/definitions/quantity" }
      }
    }
  },
  "allOf": [
    {
      "description": "Usage response: one object per requested meter, in request order.",
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/definitions/meterUsage" }
    }
  ]
}
