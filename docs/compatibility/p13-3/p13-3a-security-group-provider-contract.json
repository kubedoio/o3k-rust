{
  "architecture_findings": [
    {
      "condition": "NetworkPolicy lacks an independent policy identity and lifecycle suitable for an unattached Security Group",
      "minimum_amendment": "define a durable project-owned canonical policy resource with independent UUID/generation/state and rule-parent relation, or explicitly accept a reconstructable projection mapping that cannot become authority",
      "severity": "BLOCKER"
    },
    {
      "condition": "canonical PolicyIntent requires endpoint_id while a Security Group can exist before attachment",
      "minimum_amendment": "separate group policy identity from endpoint-targeted compiled PolicyIntent and define attachment compilation semantics",
      "severity": "HIGH"
    }
  ],
  "artifact_type": "o3k-p13-3a-security-group-provider-contract",
  "bounded_candidate_subset": {
